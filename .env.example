# =========================================================================
# Clutch (ক্ল্যাচ) - Environment Configuration Template
# Copy to .env and adjust credentials as appropriate for your environment.
# =========================================================================

# Runtime Mode: development | staging | production
ENVIRONMENT=development
API_PORT=8000

# -------------------------------------------------------------------------
# Meta Graph Webhooks (Facebook Messenger & Instagram Direct)
# -------------------------------------------------------------------------
# Webhook verification token entered into Facebook App Dashboard
META_VERIFY_TOKEN=clutch_verify_token_sample

# Meta App Secret used to calculate and verify X-Hub-Signature-256 HMAC
META_APP_SECRET=clutch_dev_secret_sample

# Long-lived Page Access Token for outbound replies
META_PAGE_ACCESS_TOKEN=

# -------------------------------------------------------------------------
# WhatsApp Cloud API
# -------------------------------------------------------------------------
# System user access token with whatsapp_business_messaging permissions
WHATSAPP_API_TOKEN=sample_whatsapp_cloud_api_token

# WhatsApp Business Account Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=109876543210987

# -------------------------------------------------------------------------
# Steadfast Courier Credentials
# Set to 'test' or 'sandbox' to activate mock dispatch without live API calls.
# -------------------------------------------------------------------------
STEADFAST_API_KEY=test
STEADFAST_SECRET_KEY=test
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# -------------------------------------------------------------------------
# Redis Cache, Debounce Buffer & Distributed Locks
# -------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------------------------------------------------
# Invoicing & Branding
# -------------------------------------------------------------------------
INVOICE_DIR=invoices
BRAND_NAME=Clutch Fashion

